#
#   Feature switches read by mosquitto's test suite: a test of a feature that
#   is OFF exits 77 (skipped). OFF = what the yuneta mqtt_broker does not have.
#   WITH_PERSISTENCE stays ON (the broker keeps sessions in timeranger2).
#
export INC_BRIDGE_SUPPORT=OFF WITH_TLS=OFF WITH_TLS_PSK=OFF WITH_WEBSOCKETS=OFF WITH_WEBSOCKETS_BUILTIN=OFF WITH_UNIX_SOCKETS=OFF WITH_CONTROL=OFF WITH_PLUGINS=OFF WITH_PLUGIN_DYNAMIC_SECURITY=OFF WITH_PLUGIN_ACL_FILE=OFF WITH_PLUGIN_PASSWORD_FILE=OFF WITH_PLUGIN_PERSIST_SQLITE=OFF WITH_PLUGIN_SPARKPLUG_AWARE=OFF WITH_HTTP_API=OFF WITH_SYS_TREE=OFF INC_MEMTRACK=OFF
