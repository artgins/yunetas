+#
+#   STANDIN harness: MQTT 5 does not fix the order of the properties
+#   (MQTT-2.2.2), so two packets that differ only in that order match.
+#
+_PROP_TYPES = {
+    1:'b', 2:'4', 3:'s', 8:'s', 9:'s', 11:'v', 17:'4', 18:'s', 19:'2', 21:'s',
+    22:'s', 23:'b', 24:'4', 25:'b', 26:'s', 28:'s', 31:'s', 33:'2', 34:'2',
+    35:'2', 36:'b', 37:'b', 38:'p', 39:'4', 40:'b', 41:'b', 42:'b',
+}
+
+def _varint(buf, i):
+    mult = 1
+    val = 0
+    while True:
+        if i >= len(buf):
+            raise ValueError
+        b = buf[i]
+        i += 1
+        val += (b & 127) * mult
+        mult *= 128
+        if not (b & 128):
+            return val, i
+
+def _split_props(buf, i):
+    plen, j = _varint(buf, i)
+    end = j + plen
+    if end > len(buf):
+        raise ValueError
+    props = []
+    while j < end:
+        start = j
+        ident, j = _varint(buf, j)
+        t = _PROP_TYPES.get(ident)
+        if t is None:
+            raise ValueError
+        if t == 'b':
+            j += 1
+        elif t == '2':
+            j += 2
+        elif t == '4':
+            j += 4
+        elif t == 'v':
+            _, j = _varint(buf, j)
+        elif t == 's':
+            j += 2 + int.from_bytes(buf[j:j+2], 'big')
+        elif t == 'p':
+            j += 2 + int.from_bytes(buf[j:j+2], 'big')
+            j += 2 + int.from_bytes(buf[j:j+2], 'big')
+        props.append(bytes(buf[start:j]))
+    if j != end:
+        raise ValueError
+    return buf[:i], sorted(props), buf[end:]
+
+def _props_offsets(pkt):
+    t = pkt[0] & 0xF0
+    _, i = _varint(pkt, 1)
+    if t == 0x20:                       # CONNACK
+        return [i + 2]
+    if t in (0x40, 0x50, 0x60, 0x70):   # PUBACK..PUBCOMP
+        return [i + 3]
+    if t in (0xE0, 0xF0):               # DISCONNECT, AUTH
+        return [i + 1]
+    if t in (0x90, 0xB0):               # SUBACK, UNSUBACK
+        return [i + 2]
+    if t == 0x30:                       # PUBLISH
+        tl = int.from_bytes(pkt[i:i+2], 'big')
+        j = i + 2 + tl
+        if (pkt[0] & 0x06):
+            j += 2
+        return [j]
+    return []
+
+def _split_frames(buf):
+    frames = []
+    i = 0
+    while i < len(buf):
+        rl, j = _varint(buf, i+1)
+        if j + rl > len(buf):
+            raise ValueError
+        frames.append(bytes(buf[i:j+rl]))
+        i = j + rl
+    return frames
+
+def _canonical(pkt):
+    """
+    One MQTT packet as a comparable value where the encodings the spec
+    allows for the same content are equal: properties in any order
+    (MQTT-2.2.2), and the Reason Code / Property Length that MQTT 5 lets
+    a sender omit (3.4.2.1-3.7.2.1 PUBACK..PUBCOMP, 3.14.2.1 DISCONNECT,
+    3.15.2.1 AUTH).
+    """
+    t = pkt[0] & 0xF0
+    rl, i = _varint(pkt, 1)
+    body = pkt[i:i+rl]
+    if t in (0x40, 0x50, 0x60, 0x70) and len(body) >= 2:
+        mid = body[:2]
+        rc = body[2] if len(body) > 2 else 0
+        props = _split_props(body, 3)[1] if len(body) > 3 else []
+        return (pkt[0], mid, rc, tuple(props))
+    if t in (0xE0, 0xF0):
+        rc = body[0] if len(body) > 0 else 0
+        props = _split_props(body, 1)[1] if len(body) > 1 else []
+        return (pkt[0], rc, tuple(props))
+    for off in _props_offsets(pkt):
+        head, props, tail = _split_props(pkt, off)
+        return (bytes(head[:1]), bytes(head[i:]), tuple(props), bytes(tail))
+    return bytes(pkt)
+
+def _same_but_encoding(recvd, expected):
+    try:
+        r = _split_frames(recvd)
+        e = _split_frames(expected)
+        if len(r) != len(e):
+            return False
+        for x, y in zip(r, e):
+            if x != y and _canonical(x) != _canonical(y):
+                return False
+        return True
+    except (ValueError, IndexError):
+        return False
+
 def packet_matches(name, recvd, expected):
+    if recvd != expected and _same_but_encoding(recvd, expected):
