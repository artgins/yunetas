#!/bin/bash
#
#   yuneta-agent-cert -- this node's own certificate for its agent
#
#   The agent serves /yuneta/agent/certs/yuneta_agent.{crt,key} on its secure
#   port (wss://...:1993), and a node may point other TLS servers at the
#   same files. Up to 7.30.5 the pair came with the agent, the SAME on every
#   node, and its key was published with the source: whoever has it can play
#   any node that serves it. This script makes the pair ON the node instead:
#
#     - no pair, or a PUBLISHED key (the one of before, or the test key
#       localhost.key of the source: told by the sha256 of its public key,
#       SPKI, in the key file or in the certificate -- a certificate signed
#       anew over a published key is still that key), or a key that is not
#       the certificate's: a new pair is made here, a copy of the old files
#       kept;
#     - a pair made here on another node: a cloned disk, a VM template, an
#       SD copied from a box that already started, a `docker commit` of a
#       started container. Each pair made here is bound to the node uuid it
#       was made for (yuneta-node-uuid, /yuneta/store/agent/uuid/uuid.json),
#       written beside it in yuneta_agent.uuid; when the node uuid is no
#       longer that one, the copy gets a new pair, and the old KEY is not
#       kept (overwritten and removed: it is the other node's), only the old
#       certificate. The key IS the node to its
#       control center (its login since 7.30.11): every clone with the same
#       key could claim the node of any other. A pair made here by an
#       earlier version (no yuneta_agent.uuid) is bound to the node uuid it
#       finds the first time; with no node uuid yet, the binding waits for
#       one. A copy made before that binding is not told apart;
#     - any other pair is the node's own: kept, whatever made it (a node
#       whose agent serves a certificate of its own CA keeps it, cloned or
#       not).
#
#   The new pair: an EC P-256 key, a self-signed certificate valid from
#   2000-01-01 (a box that starts with its clock behind does not take it for
#   one of the future) to 2126-12-31, named yuneta_agent.yuneta.io -- the
#   name the clients of 1993 check (ssl_server_name), so none has to change
#   it -- and this host's name in its SAN too. A client that trusted the old
#   certificate needs this node's new one (copy it, it is public).
#
#   It is /usr/libexec/yuneta/yuneta-agent-cert, run as root by the
#   package's postinst / %post and by both agents' units (ExecStartPre=+,
#   after yuneta-node-uuid; the two share the pair, and the lock below makes
#   their runs one after the other), and
#   by the agent's build on a node that builds from source (as the user that
#   builds). As root it drops to yuneta before it touches a file: the
#   directory is yuneta's.
#
#   Usage:
#       yuneta-agent-cert [ensure]    make the pair when it is missing or the
#                                     public one; else keep it
#       yuneta-agent-cert show        what is there, whether it is the
#                                     public pair, and the node uuid it is
#                                     bound to
#
#   The agents read the pair when they start: after a new one, restart them
#   (and whatever else serves the files). The old files are kept as
#   <file>.replaced-<UTC time>[.<n>], but for the key of another node. Environment, for tests:
#   YUNETA_AGENT_CERT_DIR (default /yuneta/agent/certs),
#   YUNETA_NODE_UUID_DIR (default /yuneta/store/agent/uuid) and
#   YUNETA_AGENT_CERT_OPENSSL (the openssl to run).
#
#   Copyright (c) 2026, ArtGins.
#
set -u

CERT_DIR="${YUNETA_AGENT_CERT_DIR:-/yuneta/agent/certs}"
CRT="${CERT_DIR}/yuneta_agent.crt"
KEY="${CERT_DIR}/yuneta_agent.key"
UUID_MARK="${CERT_DIR}/yuneta_agent.uuid"
NODE_UUID_DIR="${YUNETA_NODE_UUID_DIR:-/yuneta/store/agent/uuid}"
NODE_UUID=""
OWNER="yuneta"
NAME="yuneta_agent.yuneta.io"
#   sha256 of the public key (SPKI, DER) of the keys published with Yuneta:
#   the agent's up to 7.30.5, and the test key yunos/c/yuno_agent/certs/localhost.key
PUBLIC_SPKIS="ba2ee88ae21907f48710e8bcc3b376e7d333774833bdd912c1c6cc3f0c6eeefc 89e7f3e744aa67949802f14616ecd46bdd1af70e0e213342608af8ad289e5d79"

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
CMD="${1:-ensure}"

#
#   Output
#
log_info() {
    echo "yuneta-agent-cert: $*"
    logger -t yuneta-agent-cert -p user.info -- "$*" 2>/dev/null || true
}

log_warning() {
    echo "yuneta-agent-cert: WARNING: $*" >&2
    logger -t yuneta-agent-cert -p user.warning -- "$*" 2>/dev/null || true
}

log_error() {
    echo "yuneta-agent-cert: ERROR: $*" >&2
    logger -t yuneta-agent-cert -p user.err -- "$*" 2>/dev/null || true
}

#
#   The openssl: the SDK's (3.6, on every node, packaged ones included),
#   else the system's
#
find_openssl() {
    if [ -n "${YUNETA_AGENT_CERT_OPENSSL:-}" ]; then
        echo "$YUNETA_AGENT_CERT_OPENSSL"
        return 0
    fi
    if [ -x /yuneta/development/yunetas/outputs_ext/bin/openssl ]; then
        echo /yuneta/development/yunetas/outputs_ext/bin/openssl
        return 0
    fi
    command -v openssl 2>/dev/null
}

#
#   The node uuid (yuneta-node-uuid's file), or nothing when there is none yet
#
read_node_uuid() {
    local f="${NODE_UUID_DIR}/uuid.json" u
    if [ ! -e "$f" ]; then
        return 0
    fi
    if [ ! -r "$f" ]; then
        log_warning "cannot read $f: the pair is not bound to the node uuid"
        return 0
    fi
    u="$(sed -n 's/.*"uuid"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n 1)"
    if ! printf '%s' "$u" | grep -Eqx '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'; then
        log_warning "$f holds no valid uuid: the pair is not bound to the node uuid"
        return 0
    fi
    printf '%s' "$u"
}

#
#   A pair made by this script: self-signed, with the subject it gives
#
made_here() {
    local subject issuer
    subject="$("$OPENSSL" x509 -in "$CRT" -noout -subject -nameopt RFC2253 2>/dev/null)"
    issuer="$("$OPENSSL" x509 -in "$CRT" -noout -issuer -nameopt RFC2253 2>/dev/null)"
    [ "${subject#subject=}" = "CN=${NAME},O=Yuneta" ] && [ "${issuer#issuer=}" = "${subject#subject=}" ]
}

bind_to_node_uuid() {
    local tmp="${CERT_DIR}/.yuneta_agent.uuid.new.$$"
    rm -f -- "$tmp"
    if ! printf '%s\n' "$NODE_UUID" > "$tmp" || ! chmod 0644 "$tmp" || ! mv -f -- "$tmp" "$UUID_MARK"; then
        rm -f -- "$tmp"
        log_error "cannot write $UUID_MARK"
        return 1
    fi
}

#
#   What is there: missing | public | mismatch | cloned | own
#
pair_state() {
    if [ ! -s "$CRT" ] || [ ! -s "$KEY" ]; then
        echo missing
        return 0
    fi
    local spki_crt spki_key published
    spki_crt="$("$OPENSSL" x509 -in "$CRT" -noout -pubkey 2>/dev/null \
        | "$OPENSSL" pkey -pubin -outform DER 2>/dev/null | sha256sum | cut -d' ' -f1)"
    spki_key="$("$OPENSSL" pkey -in "$KEY" -pubout -outform DER 2>/dev/null | sha256sum | cut -d' ' -f1)"
    for published in $PUBLIC_SPKIS; do
        if [ "$spki_crt" = "$published" ] || [ "$spki_key" = "$published" ]; then
            echo public
            return 0
        fi
    done
    if ! "$OPENSSL" x509 -in "$CRT" -noout 2>/dev/null; then
        echo mismatch       # not a certificate
        return 0
    fi
    local pub_crt pub_key
    pub_crt="$("$OPENSSL" x509 -in "$CRT" -noout -pubkey 2>/dev/null)"
    pub_key="$("$OPENSSL" pkey -in "$KEY" -pubout 2>/dev/null)"
    if [ -z "$pub_crt" ] || [ "$pub_crt" != "$pub_key" ]; then
        echo mismatch
        return 0
    fi
    if [ -n "$NODE_UUID" ] && [ -e "$UUID_MARK" ] && made_here; then
        if [ "$(head -n 1 "$UUID_MARK" 2>/dev/null)" != "$NODE_UUID" ]; then
            echo cloned
            return 0
        fi
    fi
    echo own
}

#
#   A name of this host that fits in a SAN, or nothing
#
host_name() {
    local h
    h="$(hostname 2>/dev/null || true)"
    if printf '%s' "$h" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$'; then
        if [ "$h" != "$NAME" ]; then
            printf '%s' "$h"
        fi
    fi
}

keep_a_copy() {    # file
    local f="$1"
    if [ ! -e "$f" ] && [ ! -L "$f" ]; then
        return 0
    fi
    local stamp n=0 dst
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    dst="${f}.replaced-${stamp}"
    while [ -e "$dst" ]; do
        n=$((n + 1))
        dst="${f}.replaced-${stamp}.${n}"
    done
    if ! mv -f -- "$f" "$dst"; then
        log_error "cannot keep a copy of $f"
        return 1
    fi
}

#
#   The key of a pair made for another node (a cloned disk): that node's
#   login, so no copy of it stays here. Overwritten first where it is a file
#   of its own (never through a link)
#
remove_other_nodes_key() {
    if [ -f "$KEY" ] && [ ! -L "$KEY" ] && command -v shred >/dev/null 2>&1; then
        if shred -u -- "$KEY" 2>/dev/null; then
            return 0
        fi
    fi
    if ! rm -f -- "$KEY"; then
        log_error "cannot remove $KEY, the key of another node"
        return 1
    fi
}

make_pair() {    # [other_node]: the key there is another node's, not kept
    local other_node="${1:-}"
    local tmp_key="${CERT_DIR}/.yuneta_agent.key.new.$$"
    local tmp_crt="${CERT_DIR}/.yuneta_agent.crt.new.$$"
    local tmp_cnf="${CERT_DIR}/.yuneta_agent.cnf.new.$$"
    local san="DNS:${NAME}"
    local h
    h="$(host_name)"
    if [ -n "$h" ]; then
        san="${san},DNS:${h}"
    fi
    local validity=(-days 36500)
    if "$OPENSSL" req -help 2>&1 | grep -q -- '-not_before'; then
        validity=(-not_before 20000101000000Z -not_after 21261231235959Z)
    fi

    #   req reads a config file, by default the one of the OPENSSLDIR built
    #   into the binary: the packaged SDK's names the directory of the machine
    #   that built it, absent on the node. So it gets its own, all it needs.
    rm -f -- "$tmp_key" "$tmp_crt" "$tmp_cnf"
    if ! printf '[req]\ndistinguished_name = req_dn\n[req_dn]\n' > "$tmp_cnf"; then
        log_error "cannot write $tmp_cnf"
        return 1
    fi
    local err
    if ! err="$( umask 077 && "$OPENSSL" req -config "$tmp_cnf" -x509 \
            -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
            -keyout "$tmp_key" -out "$tmp_crt" \
            -subj "/O=Yuneta/CN=${NAME}" -addext "subjectAltName=${san}" \
            "${validity[@]}" 2>&1 >/dev/null )"; then
        rm -f -- "$tmp_key" "$tmp_crt" "$tmp_cnf"
        log_error "$OPENSSL could not make the pair: $(printf '%s' "$err" | head -n 3 | tr '\n' ' ')"
        return 1
    fi
    rm -f -- "$tmp_cnf"
    if [ "$("$OPENSSL" x509 -in "$tmp_crt" -noout -pubkey 2>/dev/null)" != \
            "$("$OPENSSL" pkey -in "$tmp_key" -pubout 2>/dev/null)" ]; then
        rm -f -- "$tmp_key" "$tmp_crt"
        log_error "the pair made does not match"
        return 1
    fi
    chmod 0640 "$tmp_key" && chmod 0644 "$tmp_crt"

    if [ "$other_node" = "other_node" ]; then
        if ! remove_other_nodes_key; then
            rm -f -- "$tmp_key" "$tmp_crt"
            return 1    # Error already logged
        fi
    elif ! keep_a_copy "$KEY"; then
        rm -f -- "$tmp_key" "$tmp_crt"
        return 1    # Error already logged
    fi
    if ! keep_a_copy "$CRT"; then
        rm -f -- "$tmp_key" "$tmp_crt"
        return 1    # Error already logged
    fi
    if ! mv -f -- "$tmp_key" "$KEY" || ! mv -f -- "$tmp_crt" "$CRT"; then
        log_error "cannot put the new pair in $CERT_DIR"
        return 1
    fi
    if [ -n "$NODE_UUID" ]; then
        bind_to_node_uuid || return 1    # Error already logged
    fi
    return 0
}

cmd_ensure() {
    local state
    state="$(pair_state)"
    case "$state" in
        own)
            if [ -n "$NODE_UUID" ] && [ ! -e "$UUID_MARK" ] && made_here; then
                bind_to_node_uuid || return 1    # Error already logged
                log_info "the agent's certificate bound to node uuid $NODE_UUID"
            fi
            return 0
            ;;
        missing|public|mismatch|cloned)
            ;;
        *)
            log_error "unknown state '$state'"
            return 1
            ;;
    esac
    local was other_node=""
    was="$(head -n 1 "$UUID_MARK" 2>/dev/null)"
    if [ "$state" = "cloned" ]; then
        other_node="other_node"
    fi
    if ! make_pair "$other_node"; then
        return 1    # Error already logged
    fi
    local fpr
    fpr="$("$OPENSSL" x509 -in "$CRT" -noout -fingerprint -sha256 2>/dev/null | sed 's/.*=//')"
    case "$state" in
        public)
            log_warning "the agent's certificate was on a key published with Yuneta: replaced by this node's own (sha256 $fpr). Restart both agents, one at a time, and give the clients of port 1993 this node's $CRT"
            ;;
        mismatch)
            log_warning "the agent's key did not match its certificate: a new pair (sha256 $fpr), the old files kept"
            ;;
        cloned)
            log_warning "the agent's pair was made for node uuid $was, and this node is $NODE_UUID (a cloned disk or image): a new pair (sha256 $fpr), the old certificate kept and its key removed (it is the other node's login). Restart both agents, and accept this node's new key in its control center"
            ;;
        missing)
            log_info "this node's agent certificate made (sha256 $fpr)"
            ;;
    esac
    return 0
}

cmd_show() {
    local state
    state="$(pair_state)"
    echo "dir:     $CERT_DIR"
    echo "state:   $state"
    echo "node:    ${NODE_UUID:-(no node uuid yet)}"
    echo "bound:   $(head -n 1 "$UUID_MARK" 2>/dev/null || echo '(none)')"
    if [ -s "$CRT" ]; then
        "$OPENSSL" x509 -in "$CRT" -noout -subject -dates -fingerprint -sha256 2>/dev/null \
            | sed 's/^/         /'
    fi
    if [ "$state" = "public" ]; then
        echo "         a key published with Yuneta: run 'ensure'"
    fi
    if [ "$state" = "cloned" ]; then
        echo "         a pair made for another node uuid (a cloned disk): run 'ensure'"
    fi
}

#
#   Main
#
case "$CMD" in
    ensure|show)
        ;;
    *)
        echo "usage: $0 [ensure|show]" >&2
        exit 2
        ;;
esac

if [ "$(id -u)" = "0" ]; then
    if ! id "$OWNER" >/dev/null 2>&1; then
        log_error "no user $OWNER to write $CERT_DIR as"
        exit 1
    fi
    exec setpriv --reuid="$OWNER" --regid="$OWNER" --init-groups -- \
        env YUNETA_AGENT_CERT_DIR="$CERT_DIR" YUNETA_NODE_UUID_DIR="$NODE_UUID_DIR" \
        YUNETA_AGENT_CERT_OPENSSL="${YUNETA_AGENT_CERT_OPENSSL:-}" \
        "$SELF" "$CMD"
fi

OPENSSL="$(find_openssl)"
if [ -z "$OPENSSL" ]; then
    log_error "no openssl to make or read the pair"
    exit 1
fi
if [ ! -d "$CERT_DIR" ]; then
    log_error "no $CERT_DIR"
    exit 1
fi

#
#   One writer at a time: the agent units, the postinst, a build
#
if ! command -v flock >/dev/null 2>&1; then
    log_warning "no flock, going on without the lock"
elif ! { exec 9>"${CERT_DIR}/.lock"; } 2>/dev/null; then
    log_warning "cannot open ${CERT_DIR}/.lock, going on without the lock"
elif ! flock -w 10 9; then
    log_warning "could not lock ${CERT_DIR}/.lock, going on"
fi

NODE_UUID="$(read_node_uuid)"

case "$CMD" in
    ensure)
        cmd_ensure
        exit $?
        ;;
    show)
        cmd_show
        ;;
esac
