{
    "global": {
        "agent.agent_environment": {
            "daemon_log_handlers": {
                "to_file": {
                    "filename_mask": "W.log"
                }
            }
        },
        "controlcenter.__json_config_variables__": {
            "__output_url__": "yunetacontrol.ovh:1989"
        },
        "authz.master": false,
        "authz.authz_service": "agent"
    },

    "environment": {
        "node_owner": "none"
    }
}
