{
    "name": "{{project}}_gui",
    "private": true,
    "version": "{{version}}",
    "type": "module",
    "description": "{{description}}",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "validate-locales": "node node_modules/@yuneta/gobj-ui/scripts/validate-locales.mjs",
        "check-markup": "node node_modules/@yuneta/gobj-ui/scripts/check-markup-strings.mjs src",
        "prebuild": "npm run validate-locales && npm run check-markup"
    },
    "dependencies": {
        "@antv/g6": "^5.1.1",
        "@yuneta/gobj-js": "^7.28.0",
        "@yuneta/gobj-ui": "^7.28.1",
        "bulma": "^1.0.4",
        "i18next": "^26.5.6",
        "maplibre-gl": "^6.16.0",
        "tabulator-tables": "^6.7.1",
        "tom-select": "^2.6.2",
        "uplot": "^1.6.32",
        "vanilla-jsoneditor": "^3.13.0"
    },
    "devDependencies": {
        "acorn": "^8.19.0",
        "vite": "^8.3.5"
    }
}
