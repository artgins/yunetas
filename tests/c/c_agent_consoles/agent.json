{
    "global": {
        "authz.master": true,
        "authz.authz_service": "agent",
        "authz.initial_load": {
            "roles": [
                {
                    "id": "root",
                    "disabled": false,
                    "description": "Super-Owner of system",
                    "realm_id": "*",
                    "parent_role_id": "",
                    "service": "*",
                    "permission": "*"
                }
            ],
            "users": [
                {
                    "id": "yuneta",
                    "roles": [
                        "roles^root^users"
                    ]
                }
            ]
        },
        "agent.timerStBoot": 100,
        "agent.console_pause_timeout": 3000,
        "agent.console_max_tx_queue": 2048
    },
    "environment": {
        "node_owner": "none"
    }
}
