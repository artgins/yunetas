{
    "global": {
        "authz.master": true,
        "authz.authz_service": "agent",
        "authz.initial_load": {
            "roles": [
                {
                    "id": "root",
                    "disabled": false,
                    "description": "Super-Owner of system",
                    "realm_id": "*",
                    "parent_role_id": "",
                    "service": "*",
                    "permission": "*"
                },
                {
                    "id": "operator",
                    "disabled": false,
                    "description": "Operator of the agent only",
                    "realm_id": "*",
                    "parent_role_id": "",
                    "service": "agent",
                    "permission": "*"
                }
            ],
            "users": [
                {
                    "id": "yuneta",
                    "roles": [
                        "roles^root^users"
                    ]
                },
                {
                    "id": "controlcenter",
                    "roles": [
                        "roles^root^users"
                    ]
                }
            ]
        },
        "agent.console_pause_timeout": 3000,
        "controlcenter.__json_config_variables__": {
            "__output_url__": "cc.test:19898"
        }
    },
    "environment": {
        "node_owner": "sandbox"
    }
}
