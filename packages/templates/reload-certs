#!/bin/sh
#######################################################################
# Triggered by certbot after successful renewal.
# 1) Copies fresh certs to /yuneta/store/certs
# 2) Reloads selected web server (nginx or openresty)
# 3) Hot-reloads TLS certificates in every running yuno via ycommand
#    (no process restart, active TLS connections are preserved).
#
# What it runs: copy-certs.sh as root (it reads the keys of
# /etc/letsencrypt, which are root's, and writes nothing in /yuneta as
# root); the reload of the web server as root (its master runs as root);
# ycommand and restart-yuneta as the user yuneta (restart-yuneta in a
# transient unit of its own, which outlives the unit of certbot).
#
# THE LIMIT: copy-certs.sh and the web server are files of /yuneta, which
# yuneta owns, and root runs them (see the page "Files outside /yuneta",
# the root features). Removing sudo from yuneta does not make yuneta a
# privilege boundary while that is so.
#
# For tests only: run by a user that is not root, with
# YUNETA_RELOAD_CERTS_TEST_ROOT set, every path is under that directory,
# the user is that user, and YUNETA_RELOAD_CERTS_TEST_SETPRIV names the
# setpriv to call. As root both are ignored.
#
# Copyright (c) 2024-2026, ArtGins.
#######################################################################
set -u    # fail on unset vars, but NOT on individual command failures

if [ "$(id -u)" -eq 0 ]; then
    ROOT=""
    OWNER="yuneta"
    SETPRIV="setpriv"
elif [ -n "${YUNETA_RELOAD_CERTS_TEST_ROOT:-}" ]; then
    ROOT="$YUNETA_RELOAD_CERTS_TEST_ROOT"
    OWNER="$(id -un)"
    SETPRIV="${YUNETA_RELOAD_CERTS_TEST_SETPRIV:-setpriv}"
else
    echo "reload-certs: run by certbot, as root" >&2
    exit 1
fi

LOG_DIR="${ROOT}/var/log/yuneta"
mkdir -p "$LOG_DIR"

STATE_DIR="${ROOT}/var/lib/yuneta"
mkdir -p "$STATE_DIR"

# A command as the user yuneta: setpriv, not su (no login shell), with the
# environment of yuneta and not root's (what an operator puts in the unit
# of certbot, the AWS_* of a DNS plugin, stays out), and in a session of
# its own (setsid: no controlling terminal of root's)
as_yuneta() {
    setsid -w "$SETPRIV" --reuid="$OWNER" --regid="$OWNER" --init-groups --reset-env -- \
        env PATH="/yuneta/bin:/usr/local/bin:/usr/bin:/bin" "$@"
}

# restart-yuneta as yuneta, handed to PID 1: certbot runs this hook in a
# oneshot unit, and what the hook leaves in the background dies with that
# unit when certbot ends -- restart-yuneta stops the yunos (yshutdown),
# waits and then restarts the agent, so it would stop the yunos and never
# start the agent. A transient unit of its own (systemd-run) outlives the
# hook. Type=exec, and no --no-block: systemd-run returns once the exec of
# the script succeeded (not when the script ends), and fails when the exec
# fails -- a 203/EXEC (SELinux: /yuneta is default_t, so the .rpm labels
# restart-yuneta bin_t) is then said, not taken for a start. Without
# systemd (no unit to die with), in the background.
start_restart_yuneta() {
    local unit rc
    if [ -d "${ROOT}/run/systemd/system" ] && command -v systemd-run >/dev/null 2>&1; then
        unit="yuneta-restart-$(date -u +%Y%m%d%H%M%S)"
        systemd-run -p Type=exec --unit="$unit" --uid="$OWNER" --gid="$OWNER" \
                --description="restart-yuneta, started by the certbot deploy hook" \
                "${ROOT}/yuneta/bin/restart-yuneta" >>"$LOG_DIR/restart-yuneta.log" 2>&1
        rc=$?
        if [ "$rc" -eq 0 ]; then
            log "restart-yuneta started as $OWNER in the unit $unit (journalctl -u $unit)"
            return 0
        fi
        log "restart-yuneta did NOT start in the unit $unit (systemd-run rc=$rc, see restart-yuneta.log and journalctl -u $unit): nothing restarted. Restart the agent by hand"
        return 1
    fi
    nohup setsid "$SETPRIV" --reuid="$OWNER" --regid="$OWNER" --init-groups --reset-env -- \
        env PATH="/yuneta/bin:/usr/local/bin:/usr/bin:/bin" \
        "${ROOT}/yuneta/bin/restart-yuneta" >>"$LOG_DIR/restart-yuneta.log" 2>&1 &
    log "restart-yuneta launched in background, as $OWNER"
}

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log() { printf '[%s] %s\n' "$(ts)" "$*" >>"$LOG_DIR/deploy-hook.log"; }

log "deploy hook started (RENEWED_LINEAGE=${RENEWED_LINEAGE:-?} RENEWED_DOMAINS=${RENEWED_DOMAINS:-?})"

# 1) Copy fresh certs into /yuneta/store/certs (synchronous, requires root).
#    --wait: when the agent's cert-sync is copying, wait for it (up to 120 s)
#    and then copy; without it the run would copy nothing and exit 0
if [ -x "${ROOT}/yuneta/store/certs/copy-certs.sh" ]; then
    if "${ROOT}/yuneta/store/certs/copy-certs.sh" --wait >>"$LOG_DIR/copy-certs.log" 2>&1; then
        log "copy-certs.sh OK"
    else
        log "copy-certs.sh FAILED (rc=$?)"
    fi
else
    log "copy-certs.sh NOT FOUND — skipping"
fi

# 2) Reload web server to pick updated certs
WEBCONF="${ROOT}/etc/yuneta/webserver"
WEBTYPE="nginx"
if [ -r "$WEBCONF" ]; then
    WEBTYPE="$(tr '[:upper:]' '[:lower:]' < "$WEBCONF" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
fi

case "$WEBTYPE" in
    openresty)
        if [ -x "${ROOT}/yuneta/bin/openresty/bin/openresty" ]; then
            if "${ROOT}/yuneta/bin/openresty/bin/openresty" -s reload >>"$LOG_DIR/deploy-hook.log" 2>&1; then
                log "openresty reload OK"
            else
                log "openresty reload FAILED (rc=$?)"
            fi
        else
            log "openresty binary NOT FOUND"
        fi
        ;;
    nginx|*)
        if [ -x "${ROOT}/yuneta/bin/nginx/sbin/nginx" ]; then
            if "${ROOT}/yuneta/bin/nginx/sbin/nginx" -s reload >>"$LOG_DIR/deploy-hook.log" 2>&1; then
                log "nginx reload OK"
            else
                log "nginx reload FAILED (rc=$?)"
            fi
        else
            log "nginx binary NOT FOUND"
        fi
        ;;
esac

# 3) Hot-reload TLS certs in every running yuno via ycommand
#    ycommand must run as the yuneta user so it can authenticate with its
#    own token.
if [ -x "${ROOT}/yuneta/bin/ycommand" ]; then
    if as_yuneta "${ROOT}/yuneta/bin/ycommand" \
            -c 'command-yuno command=reload-certs service=__yuno__' \
            >>"$LOG_DIR/deploy-hook.log" 2>&1; then
        log "ycommand reload-certs OK"
    else
        rc=$?
        log "ycommand reload-certs FAILED (rc=$rc) — falling back to restart-yuneta"
        if [ -x "${ROOT}/yuneta/bin/restart-yuneta" ]; then
            start_restart_yuneta
        else
            log "restart-yuneta NOT FOUND — certs copied but yunos still using old certs"
        fi
    fi
else
    log "ycommand NOT FOUND — falling back to restart-yuneta"
    if [ -x "${ROOT}/yuneta/bin/restart-yuneta" ]; then
        start_restart_yuneta
    fi
fi

# Record that the hook ran (auto-sync monitor looks at this timestamp)
if ! date '+%s' > "$STATE_DIR/last-deploy-hook-run"; then
    log "cannot write $STATE_DIR/last-deploy-hook-run: the auto-sync monitor will take this hook as one that never ran"
fi
log "deploy hook finished"

exit 0
