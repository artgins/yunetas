{
    "global": {
        "authz.master": true,
        "authz.authz_service": "agent",
        "authz.initial_load": {
            "roles": [
                {
                    "id": "root",
                    "disabled": false,
                    "description": "Super-Owner of system",
                    "realm_id": "*",
                    "parent_role_id": "",
                    "service": "*",
                    "permission": "*"
                }
            ],
            "users": [
                {"id": "yuneta", "roles": ["roles^root^users"]}
            ]
        },
        "agent.timerStBoot": 100,
        "agent.cert_sync_copy_cmd": "echo run >> /yuneta/store/copy-runs; if [ -e /yuneta/store/fake-copy-touch ]; then echo x >> /yuneta/store/certs/sandbox.crt; fi; exit $(cat /yuneta/store/fake-copy-rc)"
    },
    "environment": {
        "node_owner": "none"
    }
}
