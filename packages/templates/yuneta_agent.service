#
#   yuneta_agent as a native unit. It has the name of the SysV script
#   (/etc/init.d/yuneta_agent), so systemd takes it instead of the unit it
#   used to generate from that script, and `systemctl status` sees an agent
#   started at boot or by hand through systemctl. yuneta_agent22.service, the escape hatch, has a unit of its own and is not tied to this one: either can be stopped, upgraded or fail while the other keeps the node reachable.
#
#   Type=forking with the agent's own daemon: `--start` forks a WATCHER,
#   which relaunches the agent when it dies (the ydaemon of every yuno), and
#   `--pid-file` writes the watcher's pid before the start returns. systemd
#   supervises the watcher; it never restarts the agent itself (Restart=no):
#   the watcher does, and a second agent would only fight the first for its
#   ports.
#
#   KillMode=process: the yunos the agent launches live in this unit's
#   cgroup, and a stop or a restart of the agent must not take them down.
#   ExecStop asks THIS unit's agent for its orderly shutdown: first its
#   watcher ($MAINPID), which notes the SIGQUIT and will not relaunch it
#   (up to 7.25.22 it ignored it, and relaunched an agent that crashed in its
#   stop), then the agent, the child of the watcher; the watcher then ends
#   by itself. Not the
#   agent's `--stop`: that ends every process of the name, and systemd runs
#   ExecStop also when the watcher ended on its own -- a second agent that
#   found the first one running and left would take the first one with it.
#   The watcher ignores SIGTERM, so after TimeoutStopSec systemd SIGKILLs it
#   (SuccessExitStatus: a stop, not a failure) -- it, ONLY: with
#   KillMode=process the agent is not signalled. An agent hung in its
#   shutdown, or one the watcher relaunched while the stop ran, would stay
#   alive in the cgroup, unsupervised, and meet the next start; ExecStopPost
#   kills what is left of THIS agent in this unit's cgroup (the yunos have
#   other names, and live on).
#
#   An agent started by hand with `--start` runs outside this unit, and
#   systemd does not see it: start and stop it with systemctl.
#
[Unit]
Description=Yuneta agent (manages the yunos of this node)
Documentation=https://doc.yuneta.io/yuneta-agent
After=network-online.target nss-lookup.target time-sync.target remote-fs.target rsyslog.service
Wants=network-online.target

[Service]
Type=forking
User=yuneta
Group=yuneta
WorkingDirectory=~
Environment=YUNETA_DIR=/yuneta
Environment=PATH=/yuneta/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RuntimeDirectory=yuneta_agent
PIDFile=/run/yuneta_agent/yuneta_agent.pid
ExecStart=/yuneta/agent/yuneta_agent --config-file=/yuneta/agent/yuneta_agent.json --start --pid-file=/run/yuneta_agent/yuneta_agent.pid
ExecStop=-/bin/kill -QUIT $MAINPID
ExecStop=-/usr/bin/pkill -QUIT -P $MAINPID -x yuneta_agent
ExecStopPost=-/bin/sh -c 'for p in $$(cat /sys/fs/cgroup/system.slice/%n/cgroup.procs 2>/dev/null); do [ "$$(cat /proc/$$p/comm 2>/dev/null)" = "yuneta_agent" ] && kill -KILL $$p; done; exit 0'
KillMode=process
SuccessExitStatus=SIGKILL
Restart=no
TimeoutStartSec=30
TimeoutStopSec=30

#   The limits the SysV script raised: core dumps, io_uring rings (pinned
#   memory, per user) and open files (infinity is fs.nr_open, 4000000 with
#   the package's sysctl). The yunos inherit them.
LimitCORE=infinity
LimitMEMLOCK=infinity
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
