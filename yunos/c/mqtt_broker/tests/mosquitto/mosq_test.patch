+def _recv_exact(sock, n, name):
+    data = b""
+    while len(data) < n:
+        d = sock.recv(n - len(data))
+        if len(d) == 0:
+            try:
+                s = f"when reading {name} from {sock.getpeername()}"
+            except OSError:
+                s = f"when reading {name} from {sock}"
+            raise BrokenPipeError(s)
+        data += d
+    return data
+
+def _recv_frame(sock, name):
+    pkt = _recv_exact(sock, 1, name)
+    while True:
+        b = _recv_exact(sock, 1, name)
+        pkt += b
+        if not (b[0] & 0x80) or len(pkt) > 5:
+            break
+    rl, _ = _varint(pkt, 1)
+    return pkt + _recv_exact(sock, rl, name)
